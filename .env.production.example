# ==============================================================================
# VisaHobe Platform — Production Environment Configuration Template (.env.production.example)
#
# INSTRUCTIONS:
# Copy this file to .env.production on your deployment hosts / CI secret managers.
# Populate all required values with cryptographically secure, production-grade credentials.
# NEVER commit real production secrets into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Multi-Surface URLs
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Public Website (B2C Acquisition)
NEXT_PUBLIC_APP_URL=https://visahobe-platform.vercel.app
NEXT_PUBLIC_SITE_NAME="VisaHobe"

# Client Dashboard (Applicant Workspace & PWA)
NEXT_PUBLIC_CLIENT_DASHBOARD_URL=https://visahobe-client.vercel.app

# Super Admin Command Center (Restricted Staff & Partner Gateway)
NEXT_PUBLIC_SUPER_ADMIN_URL=https://visahobe-super-admin.vercel.app

# API Gateway & Realtime Socket Endpoints
API_BASE_URL=https://api.visahobe.com
REALTIME_WS_URL=wss://realtime.visahobe.com
CORS_ORIGIN=https://visahobe-platform.vercel.app,https://visahobe-client.vercel.app,https://visahobe-super-admin.vercel.app

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 Kernel RLS Database Connection
# ------------------------------------------------------------------------------
# Connection pooling (PgBouncer / Supabase / AWS RDS Proxy) for application runtime:
DATABASE_URL="postgresql://visahobe_app:[SECURE_APP_PASSWORD]@db.visahobe.internal:6543/visahobe_prod?schema=public&pgbouncer=true&connection_limit=50"

# Direct unpooled connection for Prisma migrations (Single Migration-Owner Rule):
DIRECT_URL="postgresql://postgres:[SECURE_ADMIN_PASSWORD]@db.visahobe.internal:5432/visahobe_prod?schema=public"

# PgBoss Background Worker Queue database connection:
PGBOSS_DATABASE_URL="postgresql://visahobe_app:[SECURE_APP_PASSWORD]@db.visahobe.internal:6543/visahobe_prod?schema=pgboss&pgbouncer=true"

# ------------------------------------------------------------------------------
# 3. Authentication, Multi-Tenancy & Cryptographic Tokens
# ------------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Cryptographic JWT Secret for Custom Claims Validation (Min 32 characters, 256-bit entropy)
JWT_SECRET="[GENERATE_SECURE_RANDOM_STRING_MIN_32_CHARS]"
JWT_ISSUER=https://[PROJECT_REF].supabase.co/auth/v1
JWT_AUDIENCE=authenticated
COOKIE_DOMAIN=.visahobe.com

# ------------------------------------------------------------------------------
# 4. S3-Compatible Object Storage (Cloudflare R2 / AWS S3 Private Vault)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_DOCUMENTS=visahobe-vault-production
S3_BUCKET_SCREENSHOTS=visahobe-browser-telemetry-production
S3_ACCESS_KEY_ID="[CLOUDFLARE_R2_ACCESS_KEY_ID]"
S3_SECRET_ACCESS_KEY="[CLOUDFLARE_R2_SECRET_ACCESS_KEY]"
S3_FORCE_PATH_STYLE=false
STORAGE_SECRET="[SECRET_KEY_FOR_LOCAL_STORAGE_ENCRYPTION_AND_HMAC]"

# ------------------------------------------------------------------------------
# 5. Live Browser Session Container Worker (Docker + noVNC + CDP)
# ------------------------------------------------------------------------------
BROWSER_WORKER_URL=https://browser-worker.visahobe.internal
BROWSER_SESSION_TIMEOUT_SECONDS=900
BROWSER_MAX_CONCURRENT_SESSIONS=20
STREAM_JWT_SECRET="[STREAM_JWT_SECRET_MIN_32_CHARS_FOR_VNC_WEBSOCKET]"
VNC_PASSWORD="[VNC_CONTAINER_RUNTIME_PASSWORD]"

# ------------------------------------------------------------------------------
# 6. Payment Gateways (Pay Station BDT & Stripe Global)
# ------------------------------------------------------------------------------
# Pay Station (Bangladesh Local MFS Gateway: bKash, Nagad, Rocket, Local Cards)
PAYSTATION_MERCHANT_ID="[PROD_PAYSTATION_MERCHANT_ID]"
PAYSTATION_PASSWORD="[PROD_PAYSTATION_MERCHANT_PASSWORD]"
PAYSTATION_WEBHOOK_SECRET="[PROD_PAYSTATION_HMAC_SECRET]"

# Stripe Global Gateway (International Credit Cards, Apple Pay, Google Pay)
STRIPE_SECRET_KEY="sk_live_51..."
STRIPE_PUBLISHABLE_KEY="pk_live_51..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 7. LLM Providers & Agent Inference (LangGraph & Autonomy Engine)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-api03-..."
GEMINI_API_KEY="AIzaSy..."
OPENAI_API_KEY="sk-proj-..."

# ------------------------------------------------------------------------------
# 8. Observability, Sentry & Audit Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN="https://[KEY]@o000000.ingest.sentry.io/[PROJECT_ID]"
SENTRY_ENVIRONMENT=production
