{
  "name": "@visahobe/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js",
      "default": "./dist/bridge/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@visahobe/core": "workspace:*",
    "@visahobe/shared": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
