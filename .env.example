# ==============================================================================
# VisaHobe Platform — Environment Configuration Template (.env.example)
#
# IMPORTANT:
# This file contains dummy placeholders and documentation ONLY.
# NEVER commit real credentials, production connection strings, or secret keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 Database
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://visahobe_dev:visahobe_dev_password@localhost:5432/visahobe_dev?schema=public&connection_limit=20
TEST_DATABASE_URL=postgresql://visahobe_dev:visahobe_dev_password@localhost:5433/visahobe_test?schema=public
PGBOSS_DATABASE_URL=postgresql://visahobe_dev:visahobe_dev_password@localhost:5432/visahobe_dev?schema=pgboss

# ------------------------------------------------------------------------------
# 3. Authentication (Supabase Auth / JWT)
# ------------------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=mock_supabase_anon_key_for_local_development_only
SUPABASE_SERVICE_ROLE_KEY=mock_supabase_service_role_key_for_local_development_only
JWT_SECRET=development_secret_key_minimum_32_characters_random_string_here
JWT_ISSUER=http://localhost:54321/auth/v1
JWT_AUDIENCE=authenticated

# ------------------------------------------------------------------------------
# 4. S3-Compatible Object Storage (Cloudflare R2 / MinIO / S3)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET_DOCUMENTS=visahobe-documents-dev
S3_BUCKET_SCREENSHOTS=visahobe-screenshots-dev
S3_ACCESS_KEY_ID=mock_s3_access_key_id
S3_SECRET_ACCESS_KEY=mock_s3_secret_access_key
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 5. Model Gateway & LLM Providers (Mocked in Local Dev / Phase 0)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=mock_anthropic_api_key_placeholder
GEMINI_API_KEY=mock_gemini_api_key_placeholder
OPENAI_API_KEY=mock_openai_api_key_placeholder
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 6. Observability & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json
SENTRY_DSN=https://mock_sentry_dsn_key@o000000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 7. Browser Automation Worker Gateway
# ------------------------------------------------------------------------------
BROWSER_WORKER_URL=http://localhost:4000
BROWSER_SESSION_TIMEOUT_SECONDS=900
BROWSER_MAX_CONCURRENT_SESSIONS=5
