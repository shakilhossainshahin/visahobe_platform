# ==============================================================================
# VisaHobe Browser Session Worker — Production Environment Template (.env.production.example)
#
# Containerized Isolated Headless/Headed Browser Worker (Docker + noVNC + CDP)
# ==============================================================================

NODE_ENV=production
PORT=4000
VNC_PORT=5900
WEBSOCKIFY_PORT=6080
CDP_PORT=9222

# Security & Access Secrets
VNC_PASSWORD="[VNC_RUNTIME_PASSWORD_MIN_12_CHARS]"
STREAM_JWT_SECRET="[STREAM_JWT_SECRET_MIN_32_CHARS_MATCHING_API_GATEWAY]"

# Session Configuration & Guardrails
BROWSER_SESSION_TIMEOUT_SECONDS=900
BROWSER_MAX_CONCURRENT_SESSIONS=20
BROWSER_HEADLESS=false
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
SCREEN_DEPTH=24

# S3 Telemetry / Screenshot Storage
S3_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_SCREENSHOTS=visahobe-browser-telemetry-production
S3_ACCESS_KEY_ID="[CLOUDFLARE_R2_ACCESS_KEY_ID]"
S3_SECRET_ACCESS_KEY="[CLOUDFLARE_R2_SECRET_ACCESS_KEY]"

# Observability
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN="https://[KEY]@o000000.ingest.sentry.io/[PROJECT_ID]"
SENTRY_ENVIRONMENT=production
